---
import Layout from "../layouts/Layout.astro";
import SectionContainer from "../components/SectionContainer.astro";
import ScaleCard from "../components/ScaleCard.astro";
import WholesaleContact from "../components/WholesaleContact.astro";
import { COMMERCIAL_SCALES } from "../consts/scales";
import Coin from "../icons/Coin.astro";
import TrendingUp from "../icons/TrendingUp.astro";
import UserPlus from "../icons/UserPlus.astro";
import CircleCheck from "../icons/CircleCheck.astro";
import ValueItem from "../components/ValueItem.astro";
import FAQItem from "../components/FAQItem.astro";
import { WHOLESALE_VALUES, WHOLESALE_FAQS } from "../consts/wholesale";

const activeScales = COMMERCIAL_SCALES.filter(
  (scale) => scale.isActive !== false,
);
---

<Layout
  title="Escalas Comerciales - HARDY"
  description="Escalas diseñadas para dietéticas, gimnasios, tiendas naturales y distribuidores que buscan alta rotación y rentabilidad real."
>
  <main class="pt-16">
    <!-- Hero Section -->
    <SectionContainer
      id="hero"
      class="relative py-16 overflow-hidden"
      noContainer={true}
    >
      <div class="absolute inset-0 bg-cream"></div>
      <div
        class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(195,33,54,0.08),transparent_55%)]"
      >
      </div>
      <div
        class="relative max-w-7xl mx-auto px-6 lg:px-8 text-center scrolling-section opacity-0"
      >
        <h1
          class="text-5xl md:text-6xl font-header font-extrabold text-primary uppercase mb-6"
        >
          Mayoristas
        </h1>
        <p class="text-xl text-neutral-700 max-w-4xl leading-relaxed mx-auto">
          Escalas diseñadas para dietéticas, gimnasios, tiendas naturales y
          distribuidores que buscan <span class="font-bold text-primary"
            >alta rotación</span
          > y <span class="font-bold text-primary">rentabilidad real</span>.
        </p>
        <p class="text-base text-neutral-600 max-w-3xl mx-auto mt-4">
          Armá tu pedido como quieras según tu escala. Cada nivel tiene sus
          propios precios y beneficios.
        </p>
      </div>
    </SectionContainer>

    <!-- Scales Grid -->
    <SectionContainer id="scales" class="py-16 bg-white">
      <div class="scrolling-section opacity-0">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {activeScales.map((scale) => <ScaleCard scale={scale} />)}
        </div>
      </div>
    </SectionContainer>

    <!-- Values Section: Como trabajamos -->
    <SectionContainer
      id="values"
      class="py-16 bg-neutral-50 border-t border-neutral-100"
    >
      <div class="max-w-5xl mx-auto px-4 md:px-6 scrolling-section opacity-0">
        <div class="text-center mb-12">
          <h2
            class="text-3xl md:text-4xl font-header font-extrabold text-primary uppercase mb-4"
          >
            Cómo trabajamos con nuestros
            <br />
            puntos de venta
          </h2>
          <p class="text-xl text-neutral-600 font-medium">
            Orden comercial + rotación real + margen cuidado.
          </p>
        </div>

        <div
          class="bg-white rounded-2xl shadow-lg border border-neutral-100 p-5 md:p-10"
        >
          <ul class="space-y-6">
            {
              WHOLESALE_VALUES.map((value) => (
                <ValueItem
                  title={value.title}
                  description={value.description}
                />
              ))
            }
          </ul>
        </div>
      </div>
    </SectionContainer>

    <!-- FAQ Section -->
    <SectionContainer id="faq" class="py-16 bg-white">
      <div class="max-w-3xl mx-auto px-6 scrolling-section opacity-0">
        <h2
          class="text-3xl md:text-4xl font-header font-extrabold text-primary uppercase text-center mb-10"
        >
          Preguntas Frecuentes
        </h2>
        <div class="space-y-4">
          {
            WHOLESALE_FAQS.map((faq) => (
              <FAQItem question={faq.question} answer={faq.answer} />
            ))
          }
        </div>
      </div>
    </SectionContainer>

    <!-- How it Works Section -->
    <SectionContainer id="how-it-works" class="py-16 bg-neutral-50">
      <div class="max-w-4xl mx-auto space-y-12 scrolling-section opacity-0">
        <div class="text-center">
          <h2
            class="text-3xl md:text-4xl font-header font-extrabold text-primary uppercase mb-6"
          >
            ¿Cómo funciona?
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <!-- Step 1 -->
          <div class="card text-center space-y-4">
            <div
              class="w-16 h-16 bg-primary text-white rounded-full flex items-center justify-center text-2xl font-bold mx-auto"
            >
              1
            </div>
            <h3 class="text-xl font-bold text-primary uppercase">
              Elegí tu escala
            </h3>
            <p class="text-neutral-700">
              Seleccioná la escala que mejor se adapte a tu negocio y armá tu
              pedido con los productos que prefieras.
            </p>
          </div>

          <!-- Step 2 -->
          <div class="card text-center space-y-4">
            <div
              class="w-16 h-16 bg-primary text-white rounded-full flex items-center justify-center text-2xl font-bold mx-auto"
            >
              2
            </div>
            <h3 class="text-xl font-bold text-primary uppercase">
              Contactanos
            </h3>
            <p class="text-neutral-700">
              Escribinos por WhatsApp o email para confirmar disponibilidad y
              coordinar la entrega.
            </p>
          </div>

          <!-- Step 3 -->
          <div class="card text-center space-y-4">
            <div
              class="w-16 h-16 bg-primary text-white rounded-full flex items-center justify-center text-2xl font-bold mx-auto"
            >
              3
            </div>
            <h3 class="text-xl font-bold text-primary uppercase">
              Empezá a vender
            </h3>
            <p class="text-neutral-700">
              Recibí tu pedido listo para exhibir y empezá a generar
              rentabilidad desde el día uno.
            </p>
          </div>
        </div>
      </div>
    </SectionContainer>

    <!-- Benefits Section -->
    <SectionContainer id="benefits" class="py-16 bg-white">
      <div class="max-w-6xl mx-auto scrolling-section opacity-0">
        <div class="text-center mb-12">
          <h2
            class="text-3xl md:text-4xl font-header font-extrabold text-primary uppercase mb-6"
          >
            Beneficios Mayoristas
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          <!-- Benefit 1 -->
          <div class="card text-center space-y-4 p-6">
            <div class="flex justify-center">
              <Coin class="w-12 h-12 text-secondary" />
            </div>
            <h3 class="font-bold text-primary uppercase">
              Precios Competitivos
            </h3>
            <p class="text-neutral-700 text-sm">
              Los mejores precios del mercado para maximizar tu margen.
            </p>
          </div>

          <!-- Benefit 2 -->
          <div class="card text-center space-y-4 p-6">
            <div class="flex justify-center">
              <TrendingUp class="w-12 h-12 text-secondary" />
            </div>
            <h3 class="font-bold text-primary uppercase">Alta Rotación</h3>
            <p class="text-neutral-700 text-sm">
              Productos con demanda comprobada y excelente salida.
            </p>
          </div>

          <!-- Benefit 3 -->
          <div class="card text-center space-y-4 p-6">
            <div class="flex justify-center">
              <UserPlus class="w-12 h-12 text-secondary" />
            </div>
            <h3 class="font-bold text-primary uppercase">Soporte Comercial</h3>
            <p class="text-neutral-700 text-sm">
              Asesoramiento directo y material promocional exclusivo.
            </p>
          </div>

          <!-- Benefit 4 -->
          <div class="card text-center space-y-4 p-6">
            <div class="flex justify-center">
              <CircleCheck class="w-12 h-12 text-secondary" />
            </div>
            <h3 class="font-bold text-primary uppercase">Calidad Premium</h3>
            <p class="text-neutral-700 text-sm">
              Productos naturales sin aditivos que tus clientes van a amar.
            </p>
          </div>
        </div>
      </div>
    </SectionContainer>

    <!-- New CTA Section -->
    <!-- <SectionContainer
      id="cta-new"
      class="py-16 bg-neutral-900 text-white text-center"
    >
      <div class="max-w-4xl mx-auto px-6 scrolling-section opacity-0">
        <h2
          class="text-3xl md:text-4xl font-header font-extrabold uppercase mb-8 leading-tight"
        >
          ¿Querés vender HARDY con margen y rotación?
        </h2>
        <div class="mb-8">
          <a
            href="https://api.whatsapp.com/send?phone=5491135736956&text=Hola%2C%20quiero%20vender%20HARDY"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 bg-green-500 hover:bg-green-600 text-white font-bold uppercase text-lg px-8 py-4 rounded-full transition-all shadow-lg hover:shadow-xl transform hover:scale-105"
          >
            <span>Hablar por WhatsApp</span>
          </a>
        </div>
        <p class="text-white/80 text-lg font-medium">
          Te recomendamos una escala inicial y un mix según tu tipo de tienda.
        </p>
      </div>
    </SectionContainer> -->

    <!-- Contact Section -->
    <SectionContainer id="contact" class="py-24 bg-neutral-50">
      <div class="scrolling-section opacity-0">
        <WholesaleContact />
      </div>
    </SectionContainer>
  </main>
</Layout>

<script>
  import { animate, stagger, inView } from "motion";

  inView(
    ".scrolling-section",
    (element) => {
      animate(
        element,
        { opacity: [0, 1], y: [50, 0] },
        { ease: [0.39, 0.24, 0.3, 1], duration: 1 },
      );

      const cards = element.querySelectorAll(".card");
      if (cards.length > 0) {
        animate(
          cards,
          { opacity: [0, 1], y: [25, 0] },
          { type: "spring", delay: stagger(0.25, { startDelay: 0.25 }) },
        );
      }
    },
    { margin: "0px 0px -20% 0px" },
  );
</script>
