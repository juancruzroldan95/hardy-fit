---
import CircleCheckFilled from "../icons/CircleCheckFilled.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<li class="flex items-start gap-3 md:gap-4">
  <div class="flex-shrink-0 mt-1">
    <CircleCheckFilled class="w-6 h-6 text-secondary" />
  </div>
  <div>
    <h4 class="font-bold text-primary text-lg">
      {title}
    </h4>
    <p class="text-neutral-600">
      {description}
    </p>
  </div>
</li>
